        }
      }
    },
    "With location: %lld of %lld": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S polohou: %1$lld z %2$lld"
          }
        }
      }
    },
    "Your photos and your login never leave the connection between this Mac and Google. The app collects nothing, sends nothing anywhere else and keeps no copies beyond a local thumbnail cache, your current selection and your album labels.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše fotky ani přihlášení nikdy neopustí spojení mezi tímto Macem a Googlem. Aplikace nic nesbírá, nikam jinam nic neposílá a kromě lokální mezipaměti náhledů, aktuálního výběru a vašich štítků alb si nic neukládá."
          }
        }
      }
    },
    "the operation was interrupted": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "operace byla přerušena"
          }
        }
      }
