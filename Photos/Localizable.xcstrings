    "The folder is not writable — %lld files saved, the rest stayed selected": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do složky nelze zapisovat — uloženo souborů: %lld, zbytek zůstal vybraný"
          }
        }
      }
    },
    "The photos stay in your library and in any other albums.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky zůstanou v knihovně i v ostatních albech."
          }
        }
      }
    },
    "This app is a native interface on top of the official Google Photos website. You sign in to Google yourself, right here in the app, and everything you do — browsing, sorting into albums, downloading — happens inside that session, exactly as if you clicked through photos.google.com by hand.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato aplikace je nativní rozhraní postavené nad oficiálním webem Google Photos. Ke Googlu se přihlašujete sami, přímo v aplikaci, a všechno, co děláte — prohlížení, třídění do alb, stahování — se odehrává uvnitř této relace, přesně jako byste na photos.google.com klikali ručně."
          }
        }
      }
    },
    "This doesn’t look like an email address: %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle nevypadá jako e-mailová adresa: %@"
          }
